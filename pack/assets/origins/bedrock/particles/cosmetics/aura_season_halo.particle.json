{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "origins:cosmetics/aura_season_halo",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "origins:cosmetics/aura_season_halo"
      }
    },
    "components": {
      "cobblemon:emitter_space": {
        "scaling": "entity"
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 2.5
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 10,
        "max_particles": 24
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          "math.sin(v.emitter_age * 360) * 0.6",
          1.45,
          "math.cos(v.emitter_age * 360) * 0.6"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.16 * math.sin(180 * v.particle_age / v.particle_lifetime)",
          "0.16 * math.sin(180 * v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 16,
          "texture_height": 8,
          "uv_size": [
            8,
            8
          ],
          "uv": [
            "math.floor(v.particle_random_1 * 2) * 8",
            0
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          1,
          1,
          1,
          "1 - math.pow(v.particle_age / v.particle_lifetime, 2)"
        ]
      },
      "minecraft:particle_initial_speed": 0,
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(1.6, 2.0)"
      },
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 0
      }
    }
  }
}
