  "commands": [
    {
      "id": "spawn_cmd",
      "command": "spawn",
      "actions": [
        "[console] execute as %player_uuid% at @s run function origins:spawn"
      ]
    },
    {
      "id": "rules_cmd",
      "command": "rules",
      "actions": [
        "[message] &#e2b04a&l✦ Cobblemon Origins Rules ✦",
        "[message] &#f7d27a1. &#fff1d0Be respectful. No harassment, hate speech or discrimination.",
        "[message] &#f7d27a2. &#fff1d0No cheating: no hacked clients, x-ray, duping or exploits. Report bugs to staff.",
        "[message] &#f7d27a3. &#fff1d0No griefing or stealing, including with claims: never claim around, inside or next to another player's build to block, trap or take it.",
        "[message] &#f7d27a4. &#fff1d0No scamming in trades. Agree on a deal before you trade Pokémon or items.",
        "[message] &#f7d27a5. &#fff1d0No spam, advertising or excessive caps in chat.",
        "[message] &#f7d27a6. &#fff1d0Keep builds, names and skins appropriate.",
        "[message] &#f7d27a7. &#fff1d0No lag machines or farms that hurt server performance.",
        "[message] &#f7d27a8. &#fff1d0Staff decisions are final. Ask on Discord if something is unclear.",
        "[message] &#9aa6c4Breaking the rules can lead to a mute, kick or ban. Appeals: /discord"
      ]
    },
    {
      "id": "discord_cmd",
      "command": "discord",
      "actions": [
        "[console] tellraw %player_name% [\"\",{\"text\":\"Join the Cobblemon Origins Discord: \",\"color\":\"#fff1d0\"},{\"text\":\"discord.gg/tEtQvqXjf8\",\"color\":\"#6a92dd\",\"underlined\":true,\"clickEvent\":{\"action\":\"open_url\",\"value\":\"https://discord.gg/tEtQvqXjf8\"},\"hoverEvent\":{\"action\":\"show_text\",\"contents\":\"Open the invite\"}}]"
      ]
    },
    {
      "id": "help_cmd",
      "command": "commands",
      "actions": [
        "[message] &#f7d27aCobblemon Origins commands",
        "[message] &#f7d27a/menu &#fff1d0- Open the server menu: spawn, wild, homes, warps",
        "[message] &#f7d27a/spawn &#fff1d0- Go to the spawn town",
        "[message] &#f7d27a/rtp &#fff1d0- Teleport somewhere random in the wild",
        "[message] &#f7d27a/home [name] &#fff1d0- Go to a home. /sethome [name] and /delhome <name> manage them",
        "[message] &#f7d27a/back &#fff1d0- Return to where you last teleported or died",
        "[message] &#f7d27a/warp <name> &#fff1d0- Go to a warp (or /menu, then Warps)",
        "[message] &#f7d27a/rules &#fff1d0- Server rules",
        "[message] &#f7d27a/discord &#fff1d0- Join our Discord",
        "[message] &#f7d27a/sb &#fff1d0- Show or hide the sidebar",
        "[message] &#9aa6c4Ranks unlock more homes with active playtime. Elite and above can use /pc anywhere."
      ]
    }
  ]
}